{
  "info": {
    "name": "若依管理系统接口测试（33条）",
    "description": "对应《接口测试用例.xlsx》33 条用例。\n前置：1) 若依运行在 {{baseUrl}}；2) 验证码开关已关闭（参数设置 sys.account.captchaEnabled=false）。\n注意：退出登录用例放在最后，执行中途不要单独跑它。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 全局时间戳变量，用于生成唯一测试数据名",
          "pm.variables.set('ts', pm.variables.get('ts') || String(Date.now()));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8888/dev-api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01-登录认证",
      "item": [
        {
          "name": "TC-API-LOGIN-001 正确账号密码登录获取Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\"password\":\"admin123\"}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"TC-API-LOGIN-001: code=200 且 token 非空\", () => {",
                  "    pm.expect(json.code).to.eql(200);",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "// 保存 token 供后续请求使用",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
          ]
        },
