# 环境变量示例：复制本文件内容到你的系统环境变量（或 shell 配置）中，按实际环境修改。
# 所有变量均有安全默认值，仅当你的环境与默认值不同时才需要设置。

# 被测系统前端地址
RUOYI_BASE_URL=http://localhost:8888/

# 测试账号（若依开源默认账号，若你改过密码请替换；属公开默认值，非机密）
RUOYI_USERNAME=admin
RUOYI_PASSWORD=admin123

# 数据库连接——仅「运行前清理残留测试用户」功能需要；
# 不设置 RUOYI_DB_PASSWORD 时该功能静默跳过，不影响用例执行。
# 真实密码只放在你本机环境变量里，不要提交到仓库。
RUOYI_DB_HOST=localhost
RUOYI_DB_PORT=3306
RUOYI_DB_USER=root
RUOYI_DB_PASSWORD=<你的MySQL密码>
RUOYI_DB_NAME=ry-vue
